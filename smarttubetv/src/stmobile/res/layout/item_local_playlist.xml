<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="88dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp"
    android:paddingVertical="8dp" android:background="@drawable/dreampipe_library_row_background" android:clickable="true" android:focusable="true">
    <CheckBox android:id="@+id/playlist_selected" android:layout_width="40dp" android:layout_height="48dp"
        android:visibility="gone" android:clickable="false" android:focusable="false"
        android:importantForAccessibility="no" />
    <FrameLayout android:layout_width="96dp" android:layout_height="56dp" android:background="@color/mobile_color_placeholder">
        <ImageView android:id="@+id/playlist_thumbnail" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" />
        <ImageView android:id="@+id/playlist_badge" android:layout_width="28dp" android:layout_height="match_parent" android:layout_gravity="end"
            android:padding="4dp" android:background="#B3000000" android:src="@drawable/ic_dreampipe_playlists"
            app:tint="@android:color/white" android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/playlist_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textSize="15sp" android:maxLines="2" android:ellipsize="end"
            android:textColor="@color/mobile_color_on_surface" />
        <TextView android:id="@+id/playlist_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/mobile_color_on_surface_secondary" />
    </LinearLayout>
    <ImageButton android:id="@+id/playlist_drag" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
        android:src="@drawable/ic_dreampipe_drag" android:contentDescription="@string/dreampipe_sort_manual" />
</LinearLayout>
