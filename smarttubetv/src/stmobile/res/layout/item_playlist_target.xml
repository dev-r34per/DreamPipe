<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="80dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingHorizontal="20dp" android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/target_thumbnail" android:layout_width="80dp" android:layout_height="46dp"
        android:scaleType="centerCrop" android:background="@color/mobile_color_placeholder" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/target_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textSize="15sp" android:textColor="@color/mobile_color_on_surface" />
        <TextView android:id="@+id/target_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/mobile_color_on_surface_secondary" />
    </LinearLayout>
    <!-- The row owns touch, keyboard and accessibility selection; the checkbox is its indicator. -->
    <CheckBox android:id="@+id/target_checked" android:layout_width="48dp" android:layout_height="48dp"
        android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
</LinearLayout>
