<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dreampipe_description_page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/mobile_color_background" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/dreampipe_description_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="20sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/mobile_color_on_surface" android:textIsSelectable="true" />
        <TextView android:id="@+id/dreampipe_description_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp"
            android:textColor="@color/mobile_color_on_surface_secondary" android:textIsSelectable="true" />
        <TextView android:id="@+id/mobile_watch_description" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingBottom="24dp"
            android:textSize="15sp" android:lineSpacingExtra="3dp" android:autoLink="web"
            android:textColor="@color/mobile_color_on_surface" android:textColorLink="@color/mobile_color_link"
            android:textIsSelectable="true" android:text="@string/dreampipe_description_loading" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
